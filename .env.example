# ============================================================
# notice-filter-nlp 환경변수 템플릿 (실제 비밀키는 .env에만 저장)
# 주의(ADR-02): 학교 통합계정(INFO21) 자격증명은 수집 범위 제외 원칙상 저장하지 않음
# ============================================================

# 1. 외부 공공 API (선택/확장 소스: 온통청년 Open API)
YOUTH_POLICY_API_KEY=
YOUTH_CONTENT_API_KEY=
YOUTH_CENTER_API_KEY=

# 2. Discord 알림 및 피드백 수집 봇 어댑터
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# 3. 오프라인 Silver 라벨링용 LLM-as-a-Judge (추론/실서비스 시 미사용)
LLM_JUDGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001
